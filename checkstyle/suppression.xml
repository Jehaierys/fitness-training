<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>

    <suppress
            files=".*ExceptionSuppliers.java"
            checks="MagicNumber"/>

    <suppress
            files=".*ExceptionSuppliers.java"
            checks="MethodName"/>

    <suppress
            files=".*/com/fitnesstraining/api/openapi/.*"
            checks="LineLength"/>

    <suppress
            files=".*SecurityConfig\.java"
            checks="DeclarationOrder"/>

    <suppress
            files=".*ValidationErrorMessages\.java"
            checks="WhitespaceAround|DeclarationOrder"/>

    <suppress
            files=".*/src/test/java/.*"
            checks=".*"/>

</suppressions>